
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Detail Karya - Ruang Aksara</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
      transition: .2s;
    }
    body.dark { background: #111827; color: #f3f4f6; }
    header {
      background: white;
      border-bottom: 1px solid #e5e7eb;
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    body.dark header, body.dark .article {
      background: #1f2937;
      border-color: #374151;
    }
    .brand { font-size: 20px; font-weight: bold; }
    .header-actions { display: flex; gap: 8px; }
    button, .button {
      border: 0;
      border-radius: 9px;
      padding: 11px 15px;
      cursor: pointer;
      font-weight: bold;
      text-decoration: none;
      font-size: 14px;
    }
    .secondary { background: #e5e7eb; color: #1f2937; }
    .primary { background: #3157d5; color: white; }
    body.dark .secondary { background: #374151; color: white; }
    main { max-width: 850px; margin: 32px auto; padding: 0 20px; }
    .article {
      background: white;
      border-radius: 18px;
      padding: 32px;
      box-shadow: 0 8px 28px #0000000c;
    }
    .category {
      display: inline-block;
      color: #3157d5;
      background: #eef2ff;
      border-radius: 20px;
      padding: 7px 12px;
      font-size: 12px;
      font-weight: bold;
    }
    h1 { font-size: clamp(27px, 5vw, 40px); line-height: 1.2; margin: 18px 0 12px; }
    .meta { color: #7b8494; font-size: 13px; line-height: 1.8; }
    .cover {
      display: block;
      width: 100%;
      max-height: 420px;
      object-fit: cover;
      border-radius: 13px;
      margin: 25px 0;
    }
    .description {
      font-size: 17px;
      line-height: 1.8;
      color: #64748b;
      border-left: 3px solid #3157d5;
      padding-left: 15px;
      margin: 22px 0;
    }
    body.dark .description, body.dark .meta { color: #cbd5e1; }
    .content {
      font-size: 17px;
      line-height: 1.95;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }
    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      border-top: 1px solid #e5e7eb;
      padding-top: 22px;
      margin-top: 30px;
    }
    body.dark .actions { border-color: #374151; }
    .empty { text-align: center; padding: 55px 25px; }
    .empty h2 { margin-bottom: 8px; }
    .empty p { color: #7b8494; line-height: 1.6; }
    footer { text-align: center; color: #8490a0; padding: 25px; font-size: 12px; }
    @media(max-width: 600px) {
      header { padding: 15px; }
      .brand { font-size: 16px; }
      main { margin: 18px auto; padding: 0 12px; }
      .article { padding: 22px 17px; }
      .content { font-size: 16px; }
    }
  </style>
</head>
<body>
  <header>
    <a href="index.html" class="brand" style="text-decoration:none;color:inherit">📚 Ruang Aksara</a>
    <div class="header-actions">
      <button class="secondary" id="themeBtn" type="button">🌙</button>
      <a class="button secondary" href="index.html">Beranda</a>
    </div>
  </header>

  <main>
    <article class="article" id="article">
      <div class="empty">
        <h2>Memuat karya...</h2>
      </div>
    </article>
  </main>

  <footer>© Ruang Aksara STT Cipasung · Ruang Literasi Kampus</footer>

  <script>
    const WORK_KEY = "ruangAksaraWorks";
    const FAVORITE_KEY = "ruangAksaraFavorites";
    const params = new URLSearchParams(location.search);
    const workId = params.get("id");

    function readStorage(key) {
      try {
        const value = JSON.parse(localStorage.getItem(key));
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function escapeHTML(value) {
      const div = document.createElement("div");
      div.textContent = String(value ?? "");
      return div.innerHTML;
    }

    function getImage(work) {
      if (work.image) return work.image;
      const category = String(work.category || "").toLowerCase();
      if (category === "cerita") return "images/cerita.jpg";
      if (category === "artikel") return "images/artikel.jpg";
      return "images/puisi.jpg";
    }

    function renderWork() {
      const works = readStorage(WORK_KEY);
      const work = works.find(item => String(item.id) === String(workId));
      const article = document.getElementById("article");

      if (!work) {
        article.innerHTML = `
          <div class="empty">
            <h2>Karya tidak ditemukan</h2>
            <p>Karya mungkin belum tersimpan di browser ini atau tautannya tidak sesuai.</p>
            <a class="button primary" href="index.html">Kembali ke Beranda</a>
          </div>`;
        return;
      }

      const favorites = readStorage(FAVORITE_KEY);
      const isFavorite = favorites.some(item =>
        String(item.id) === String(work.id) ||
        (item.title === work.title && item.category === work.category)
      );

      const date = work.createdAt && !isNaN(new Date(work.createdAt))
        ? new Date(work.createdAt).toLocaleDateString("id-ID", {
            day: "numeric", month: "long", year: "numeric"
          })
        : "Tanggal tidak tersedia";

      article.innerHTML = `
        <span class="category">${escapeHTML(work.category || "Karya")}</span>
        <h1>${escapeHTML(work.title || "Tanpa Judul")}</h1>
        <div class="meta">
          ✍️ ${escapeHTML(work.author || "Penulis Ruang Aksara")}
          &nbsp; · &nbsp; 📅 ${date}
        </div>
        <img class="cover" src="${escapeHTML(getImage(work))}" alt="Sampul karya"
          onerror="this.style.display='none'">
        ${work.description ? `<div class="description">${escapeHTML(work.description)}</div>` : ""}
        <div class="content">${escapeHTML(work.content || "Isi karya belum tersedia.")}</div>
        <div class="actions">
          <button class="primary" id="favoriteBtn" type="button">
            ${isFavorite ? "♥ Hapus dari Favorit" : "♡ Tambah ke Favorit"}
          </button>
          <a class="button secondary" href="index.html#karya">← Kembali ke Karya</a>
          <a class="button secondary" href="kirim-karya.html">✎ Kirim Karya</a>
        </div>`;

      document.getElementById("favoriteBtn").addEventListener("click", () => {
        toggleFavorite(work);
      });
    }

    function toggleFavorite(work) {
      let favorites = readStorage(FAVORITE_KEY);
      const exists = favorites.some(item =>
        String(item.id) === String(work.id) ||
        (item.title === work.title && item.category === work.category)
      );

      if (exists) {
        favorites = favorites.filter(item =>
          !(String(item.id) === String(work.id) ||
            (item.title === work.title && item.category === work.category))
        );
      } else {
        favorites.unshift({
          id: work.id,
          title: work.title,
          category: work.category,
          description: work.description || "",
          content: work.content || "",
          image: work.image || "",
          author: work.author || "Penulis Ruang Aksara",
          createdAt: work.createdAt || ""
        });
      }

      localStorage.setItem(FAVORITE_KEY, JSON.stringify(favorites));
      renderWork();
    }

    const themeBtn = document.getElementById("themeBtn");

    function applyTheme() {
      const dark = localStorage.getItem("ruangAksaraDarkMode") === "true";
      document.body.classList.toggle("dark", dark);
      themeBtn.textContent = dark ? "☀️" : "🌙";
    }

    themeBtn.addEventListener("click", () => {
      const dark = document.body.classList.contains("dark");
      localStorage.setItem("ruangAksaraDarkMode", String(!dark));
      applyTheme();
    });

    applyTheme();
    renderWork();
  </script>
</body>
</html>
